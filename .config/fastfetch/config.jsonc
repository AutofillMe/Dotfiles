{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.config/fastfetch/pngs/ogami_transparent.png",
    	"type": "kitty",
    	"height": 14,
    	"padding": {
    		"top": 2
    	}
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#33}󰍺 display {#keys}│",
            "type": "display"
        },
        {
            "key": "│ {#35}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
     
        {
            "key": "│ {#36} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#31}󰨇 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#32} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#33} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#35}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "key": "│ {#36}󰨜 gpu     {#keys}│",
            "type": "gpu",
            "driverSpecific": true,
            "temp": true
        },
        {
            "key": "│ {#31} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#32}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#33}󰩟 network {#keys}│",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "│ {#34}󱊣 battery {#keys}│",
            "type": "battery"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
