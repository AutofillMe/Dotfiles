{
	"Python Default Boilerplate": {
		"prefix": "pybase",
		"body": [
			"import argparse",
			"import signal",
			"lazy from datetime import datetime",
			"lazy from time import perf_counter",
			"",
			"# ========== CONSTANTS ==========",
			"DEBUG: bool = False",
			"",
			"",
			"def signal_handler(sig, frame) -> None:",
			"    print(\"\\nInterrupted by user. Exiting gracefully...\")",
			"    if DEBUG == True:",
			"        print(f\"Function: {frame.f_code.co_name}\")",
			"        print(f\"Line: {frame.f_lineno}\")",
			"        print(f\"Local vars: {frame.f_locals}\")",
			"        print(f\"Global vars: {frame.f_globals}\")",
            "    raise SystemExit(0)",
			"",
			"",
			"def main() -> None:",
			"    global DEBUG",
			"",
			"    parser = argparse.ArgumentParser()",
			"    parser.add_argument(",
			"        \"--debug\",",
			"        action = \"store_true\",",
			"        help = \"Enable debug mode\",",
			"    )",
			"    args: argparse.Namespace = parser.parse_args()",
			"",
			"    DEBUG = args.debug",
			"    signal.signal(signal.SIGINT, signal_handler)",
			"",
			"    if DEBUG:",
			"        print(\"DEBUG: Entered main()\")",
			"        start = perf_counter()",
			"        print(f\"Script started at {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")",
			"",
			"    # Code goes here",
			"    $0",
			"",
			"    if DEBUG:",
			"        elapsed = perf_counter() - start",
			"        print(f\"Script finished at {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} (Total time elapsed: {elapsed})\")",
			"",
			"if __name__ == \"__main__\":",
			"    main()",
		],
		"description": "Python starter boilerplate with signal handling and argparse"
	},
	"Python file shebang": {
        "prefix": "#env",
        "body": "#!/usr/bin/env python$0",
        "description": "Shebang line for the first python in PATH"
    },
}
