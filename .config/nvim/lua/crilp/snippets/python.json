{
	"Python Default Boilerplate": {
		"prefix": "pybase",
		"body": [
			"#!/usr/bin/env python3.15",
			"import argparse",
			"import signal",
			"lazy from datetime import datetime",
			"lazy from time import perf_counter",
			"",
			"# ========== CONSTANTS ==========",
			"DEBUG: bool = False",
			"",
			"",
			"def signal_handler(sig, frame) -> None:",
			"    print(\"\\nInterrupted by user. Exiting gracefully...\")",
			"    if DEBUG:",
			"        print(f\"Signal: {signal.Signals(sig).name}\")", 
			"        print(f\"Function: {frame.f_code.co_name}\")",
			"        print(f\"Line: {frame.f_lineno}\")",
			"        print(f\"Local vars: {frame.f_locals}\")",
			"    raise SystemExit(130)",
			"",
			"",
			"def parse_args() -> argparse.Namespace:",
			"    parser = argparse.ArgumentParser()",
			"    parser.add_argument(",
			"        \"--debug\",",
			"        action=\"store_true\",",
			"        help=\"<optional: NOARGS> Enable debug mode\"",
			"    )",
			"",
			"    return parser.parse_args()",
			"",
			"",
			"def main() -> None:",
			"    global DEBUG",
			"",
			"    args: argparse.Namespace = parse_args()",
			"",
			"    DEBUG = args.debug",
			"    signal.signal(signal.SIGINT, signal_handler)",
			"",
			"    if DEBUG:",
			"        print(\"DEBUG: Entered main()\")",
			"        start = perf_counter()",
			"        print(f\"Script started at {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")",
			"",
			"    try:",
			"        pass$0",
			"    finally:",
			"        if DEBUG:",
			"            elapsed = perf_counter() - start",
			"            print(f\"Script finished at {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")",
			"            print(f\"Total time elapsed: {elapsed}\")",
			"",
			"if __name__ == \"__main__\":",
			"    main()"
		],
		"description": "Python starter boilerplate with signal handling and argparse"
	},
	"Python file shebang": {
